// Shared settings: arm64 macOS 26+, SDK 27, warnings are errors.
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
SWIFT_VERSION = 6.0
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
